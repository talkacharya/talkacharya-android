  "doshaMangalName": "मंगल दोष",
  "doshaMangalMeaning": "मंगल संवेदनशील भाव में — विवाह से पहले परंपरागत रूप से विचार किया जाता है। अक्सर तब संतुलित होता है जब दोनों साथी मांगलिक हों या गुरु मंगल को प्रभावित करे।",
  "doshaKaalSarpaName": "काल सर्प दोष",
  "doshaKaalSarpaMeaning": "पूरी कुंडली राहु और केतु के बीच — दिशा मिलने तक जीवन बँधा-बँधा लग सकता है, फिर एकाग्रता तीव्र हो जाती है।",
  "doshaPitraName": "पितृ दोष",
  "doshaPitraMeaning": "सूर्य और नवम भाव पर पूर्वजों के कर्म की छाया — प्रायः पिता के नाम पर श्राद्ध और दान से इसका समाधान किया जाता है।",
  "doshaGandmoolName": "गंडमूल दोष",
  "doshaGandmoolMeaning": "चंद्रमा संधि नक्षत्र में है। 27वें दिन शांति पूजा परंपरागत उपाय है।",
  "doshaGrahanName": "ग्रहण दोष",
  "doshaGrahanMeaning": "सूर्य या चंद्र किसी छाया ग्रह के साथ — उस ग्रह के फल तब तक मंद रहते हैं जब तक उन पर काम न हो।",
  "doshaShrapitName": "शापित दोष",
  "doshaShrapitMeaning": "शनि के साथ राहु — शुरुआत में देरी और उलझन; धैर्य और लगातार प्रयास ही रास्ता है।",
  "doshaGuruChandalName": "गुरु चांडाल दोष",
  "doshaGuruChandalMeaning": "गुरु के साथ छाया ग्रह — ज्ञान के साथ अपरंपरागत विचार; गुरु और मान्यताएँ सोच-समझकर चुनें।",
  "doshaAngarakName": "अंगारक दोष",
  "doshaAngarakMeaning": "मंगल के साथ छाया ग्रह — आवेगपूर्ण ऊर्जा; क्रोध, दुर्घटना और संपत्ति विवाद में सावधानी ज़रूरी।",
  "doshaKemadrumaName": "केमद्रुम दोष",
  "doshaKemadrumaMeaning": "चंद्रमा अकेला, आसपास कोई सहारा नहीं — केंद्र भाव भरा हो या चंद्रमा बलवान हो तो कम हो जाता है।",
  "doshaDaridraName": "दरिद्र दोष",
  "doshaDaridraMeaning": "धन भाव दबाव में — अनुशासित बचत और बलवान दशा इसे बदल देती है।",
  "birthDetailsCta": "पूरा जन्म विवरण",
