  "yogaIntro": "யோகங்கள் என்பவை போக்குகளே தவிர, உத்தரவாதங்கள் அல்ல — சம்பந்தப்பட்ட கிரகங்கள் நல்ல நிலையில் அமைந்து, தசா காலத்தில் இயங்கும்போது அவை வலுப்பெறுகின்றன.",
  "yogaNoneTitle": "பாரம்பரிய யோகாக்கள் எதுவும் கண்டறியப்படவில்லை",
  "yogaNoneBody": "அது பொதுவானதுதான், கெட்ட அறிகுறியும் அல்ல — ஜாதகம் இன்னமும் அதன் வீடுகள் மற்றும் தசா மூலமாகவே படிக்கப்படுகிறது.",
  "kundaliTalkToAstrologer": "ஒரு ஜோதிடரிடம் பேசுங்கள்",
  "kundaliHowItPlaysOut": "இவை உங்கள் வாழ்க்கையிலும் நேரத்திலும் எவ்வாறு வெளிப்படுகின்றன என்பதைத் தெரிந்துகொள்ள விரும்புகிறீர்களா?",
  "yogaGajakesariName": "கஜகேசரி யோகா",
  "yogaGajakesariMeaning": "சந்திரனிலிருந்து கேந்திரத்தில் வியாழன் — நிதானம், சிறந்த முடிவெடுக்கும் திறன் மற்றும் மதிப்புமிக்க பெயர்.",
  "yogaBudhadityaName": "புத்தாதித்ய யோகா",
  "yogaBudhadityaMeaning": "சூரியனும் புதனும் இணைந்தால் — கூர்மையான, வெளிப்படுத்தும் திறன் கொண்ட மனம்; படிப்பதற்கும், எழுதுவதற்கும், பகுப்பாய்வு செய்வதற்கும் வலிமையானது.",
  "yogaChandraMangalaName": "சந்திர-மங்கள யோகா",
  "yogaChandraMangalaMeaning": "சந்திரன் செவ்வாயுடன் — பணம் மற்றும் தொழில்முனைப்பைச் சார்ந்த இயக்கம்; முயற்சி மற்றும் முன்முயற்சியின் மூலம் சம்பாதித்தல்.",
  "yogaRajaName": "ராஜ யோகம்",
  "yogaRajaMeaning": "கேந்திர அதிபதி திரிகோண அதிபதியுடன் தொடர்புடையவர் என்றால், அந்தக் காலம் தொடரும்போது அந்தஸ்து, அதிகாரம் மற்றும் வாய்ப்புகளில் உயர்வு ஏற்படும்.",
  "yogaDhanaName": "தன யோகா",
  "yogaDhanaMeaning": "செல்வமும் ஆதாயங்களும் ஒன்றோடொன்று இணைந்திருப்பது, சேமிப்பையும் நிலையான நிதி வளர்ச்சியையும் ஆதரிக்கிறது.",
  "yogaNeechabhangaName": "நீச்சபங்க ராஜ யோகம்",
  "yogaNeechabhangaMeaning": "பலவீனமடைந்த ஒரு கிரகத்தின் பலவீனம் ரத்து செய்யப்படுகிறது — ஆரம்பகாலப் போராட்டம் வலிமையாக மாறுகிறது.",
  "yogaKaalSarpaName": "கால சர்ப்ப யோகா",
  "yogaKaalSarpaMeaning": "ராகு-கேது அச்சின் ஒரு பக்கத்தில் ஏழு கிரகங்களும் இருப்பதால், ஒரு தெளிவான திசை கிடைக்கும் வரை வாழ்க்கை நெருக்கடிக்குள்ளானது போல் உணரலாம்.",
  "yogaAdhiName": "அதி யோகா",
  "yogaAdhiMeaning": "சந்திரனிலிருந்து 6, 7 மற்றும் 8 ஆம் வீடுகளில் உள்ள சுப கிரகங்கள் — பாதுகாப்பு, திறமையான உதவியாளர்கள் மற்றும் ஒரு நிலையான நிலை.",
  "yogaShakataName": "ஷகத யோகா",
  "yogaShakataMeaning": "வியாழனிலிருந்து 6, 8 அல்லது 12 ஆம் வீட்டில் சந்திரன் — ஏற்ற இறக்கமுள்ள அதிர்ஷ்டம்; சந்திரன் வலுவாக இருக்கும்போது நிலையானது.",
  "yogaVishName": "விஷ் யோகா",
  "yogaVishMeaning": "சந்திரன் சனியுடன் சேரும்போது — மனம் பாரமாகக் காணப்படும்; பக்குவமடையும்போதுதான் பலன்கள் தாமதமாகக் கிடைக்கும்.",
  "yogaKahalaName": "கஹலா யோகா",
  "yogaKahalaMeaning": "பலமான லக்னாதிபதியுடன் 4 மற்றும் 9 ஆம் அதிபதிகள் பரஸ்பர கேந்திரத்தில் இருப்பது — துணிச்சலான, முயற்சிமிக்க, இடர் எடுக்கத் தயாராக இருப்பவர்.",
  "yogaPushkalaName": "புஷ்கலா யோகா",
  "yogaPushkalaMeaning": "கேந்திரத்தில் சந்திர அதிபதியும் லக்னாதிபதியும் — மரியாதை, நற்பெயர் மற்றும் வசியப்படுத்தும் பேச்சுத்திறன்.",
  "yogaDaridraName": "தரித்ரா யோகா",
  "yogaDaridraMeaning": "11-ஆம் அதிபதி (லாபம்) கடினமான வீட்டில் வீழ்ந்துள்ளார் — லாபங்கள் மெதுவாக வரும்; ஒரு பலமான தசா நிலைமையை மாற்றிவிடும்.",
  "yogaAmalaName": "அமலா யோகா",
  "yogaAmalaMeaning": "லக்னம் அல்லது சந்திரனிலிருந்து பத்தாம் வீட்டில் உள்ள சுப கிரகம் மட்டுமே — களங்கமற்ற நற்பெயரையும் நீடித்த நல்லெண்ணத்தையும் தரும்.",
  "yogaSaraswatiName": "சரஸ்வதி யோகா",
  "yogaSaraswatiMeaning": "புதன், சுக்கிரன் மற்றும் வலிமையான வியாழன் நல்ல நிலையில் அமைந்தால் — கல்வி, கலை மற்றும் சொல்லாற்றல் மேம்படும்.",
  "yogaLakshmiName": "லட்சுமி யோகா",
  "yogaLakshmiMeaning": "கேந்திரத்திலோ அல்லது திரிகோணத்திலோ பலமான லக்னாதிபதியுடன் பலமான 9-ஆம் அதிபதி — செல்வம், சுகம் மற்றும் அருள்.",
  "yogaRuchakaName": "ருச்சக யோகம்",
  "yogaRuchakaMeaning": "கேந்திரத்தில் செவ்வாய் வலுவாக உள்ளது — தைரியம், உடல் வலிமை மற்றும் நெருக்கடியான சூழ்நிலைகளில் தலைமைப் பண்பு.",
  "yogaBhadraName": "பத்ரா யோகா",
  "yogaBhadraMeaning": "கேந்திரத்தில் புதன் வலுவாக இருந்தால் — நுண்ணறிவு, தெளிவான பேச்சு மற்றும் வர்த்தகம், தகவல் தொடர்பில் திறமை.",
  "yogaHamsaName": "ஹம்சா யோகா",
  "yogaHamsaMeaning": "கேந்திரத்தில் வியாழன் வலுவாக இருந்தால் — ஞானம், நன்னெறி, போதிக்கும் அல்லது அறிவுரை வழங்கும் குணம் மற்றும் பொதுவான நல்ல அதிர்ஷ்டம் கிடைக்கும்.",
  "yogaMalavyaName": "மாலவ்ய யோகா",
  "yogaMalavyaMeaning": "கேந்திரத்தில் சுக்கிரன் வலுவாக இருந்தால் — வசீகரம், சுகம், அழகை ரசிக்கும் பார்வை மற்றும் இனிமையான இல்லற வாழ்க்கை.",
  "yogaSasaName": "சசா யோகா",
  "yogaSasaMeaning": "கேந்திரத்தில் சனி வலுவாக இருந்தால் — ஒழுக்கம், சகிப்புத்தன்மை மற்றும் அதிகாரம் ஆகியவை மெதுவாகக் கட்டமைக்கப்பட்டுப் பாதுகாக்கப்படும்.",
  "yogaUbhayachariName": "உபயாச்சாரி யோகா",
  "yogaUbhayachariMeaning": "சூரியனின் இருபுறமும் கோள்கள் — நன்கு ஆதரிக்கப்படும், புலப்படும் வாழ்க்கை மற்றும் அனைத்து வகையிலும் நல்ல நிலை.",
  "yogaVesiName": "வேசி யோகா",
  "yogaVesiMeaning": "சூரியனிலிருந்து இரண்டாம் வீட்டில் உள்ள ஒரு கிரகம் — நிலையான பேச்சு, சமநிலையான கண்ணோட்டம் மற்றும் அழகான பெயர்.",
  "yogaVasiName": "வாசி யோகா",
  "yogaVasiMeaning": "சூரியனிலிருந்து 12-ஆம் வீட்டில் உள்ள ஒரு கிரகம் — ஆற்றல், செல்வாக்கு மற்றும் தாராள குணம்.",
  "yogaShubhaKartariName": "சுப கர்த்தாரி யோகா",
  "yogaShubhaKartariMeaning": "லக்னத்தின் இருபுறமும் உள்ள சுப காரியங்கள் — பாதுகாப்பு, மென்மையான பாதை மற்றும் சாதகமான சூழ்நிலைகள்.",
  "yogaPapaKartariName": "பாப்பா கர்த்தாரி யோகா",
  "yogaPapaKartariMeaning": "லக்னத்தின் இருபுறமும் உள்ள அசுப கிரகங்கள் — சுயத்திற்கும் உடல்நலத்திற்கும் அழுத்தம்; உங்கள் ஆற்றலையும் எல்லைகளையும் பாதுகாத்துக் கொள்ளுங்கள்.",
  "yogaDurudharaName": "துரூதார யோகா",
  "yogaDurudharaMeaning": "2-ஆம் மற்றும் 12-ஆம் வீடுகளில் கிரகங்கள் சந்திரனுக்கு இருபுறமும் அமைந்துள்ளன — இது உங்களைச் சுற்றியுள்ள வளங்கள், ஆறுதல் மற்றும் நிலையான ஆதரவைக் குறிக்கிறது.",
  "yogaSunaphaName": "சுனபா யோகா",
  "yogaSunaphaMeaning": "சந்திரனிலிருந்து இரண்டாம் வீட்டில் உள்ள கிரகம் — சுயமுயற்சியால் முன்னேறிய செல்வம், நுண்ணறிவு மற்றும் நற்பெயர்.",
  "yogaAnaphaName": "அனபா புகைப்படம்",
  "yogaAnaphaMeaning": "சந்திரனிலிருந்து 12-ஆம் வீட்டில் ஒரு கிரகம் — எளிமையான குணம், நல்வாழ்வு மற்றும் தேவைகளிலிருந்து விடுதலை.",
  "yogaKemadrumaYogaName": "கெமத்ருமா யோகா",
  "yogaKemadrumaYogaMeaning": "சந்திரன் ஆதரவின்றித் தனித்து நிற்கிறது — சந்திரன் வலிமையாக இருக்கும்போதோ அல்லது கேந்திரம் செயல்படும்போதோ தணியும் ஒரு உள்ளார்ந்த அமைதியின்மை இது.",
  "yogaVasumatiName": "வாசுமதி யோகா",
  "yogaVasumatiMeaning": "லக்னம் அல்லது சந்திரனிலிருந்து வளர்ச்சி வீடுகளில் உள்ள சுப கிரகங்கள் — செல்வம் குவிதல் மற்றும் வளங்கள் பெருகுதல்.",
  "yogaKalanidhiName": "கலநிதி யோகா",
  "yogaKalanidhiMeaning": "2ஆம் அல்லது 5ஆம் வீட்டில் புதன் அல்லது சுக்கிரனுடன் இணைந்த வியாழன் — கல்வி, கலைகள், பண்பாடு மற்றும் கௌரவம்.",
  "yogaChamaraName": "சாமரா யோகா",
  "yogaChamaraMeaning": "கேந்திரத்தில் உச்சம் பெற்ற லக்னாதிபதி, குருவின் பார்வை பெற்றால் — நாவன்மை, நீண்ட ஆயுள் மற்றும் மரியாதைக்குரிய அந்தஸ்து.",
  "yogaShankhaName": "சங்க யோகா",
  "yogaShankhaMeaning": "5 மற்றும் 6 ஆம் அதிபதிகள் பலமான லக்னாதிபதியுடன் இணைந்தால் — நல்ல வாழ்க்கை, கனிவான குணம் மற்றும் பிற்காலத்தில் சுகம் கிடைக்கும்.",
  "yogaParvataName": "பர்வத யோகா",
  "yogaParvataMeaning": "கேந்திரங்களில் 6 மற்றும் 8 ஆம் வீடுகள் தூய்மையாக இருந்தால் சுப கிரகங்கள் — அதிர்ஷ்டம், தாராள குணம் மற்றும் புகழ்பெற்ற பெயர்.",
  "yogaHarshaName": "ஹர்ஷா யோகா",
  "yogaHarshaMeaning": "சவாலான வீட்டில் ஆறாம் அதிபதி — எதிரிகள், கடன்கள் மற்றும் நோய் ஆகியவற்றின் பிடி தளர்ந்துவிடும்; போட்டித்திறன் அதிகரிக்கும்.",
  "yogaSaralaName": "சரளா யோகா",
  "yogaSaralaMeaning": "கடினமான வீட்டில் எட்டாம் அதிபதி — நெருக்கடிகளைத் தாங்கும் ஆற்றல், நீண்ட ஆயுள் மற்றும் அச்சமின்மை.",
  "yogaVimalaName": "விமலா யோகா",
  "yogaVimalaMeaning": "சவாலான வீட்டில் பன்னிரண்டாம் அதிபதி — கட்டுப்படுத்தப்பட்ட செலவு, தூய்மையான மனசாட்சி மற்றும் சுதந்திரமான வாழ்க்கை.",
  "yogaMahaParivartanaName": "மகா பரிவர்த்தன யோகா",
  "yogaMahaParivartanaMeaning": "நல்ல வீடுகளின் இரு அதிபதிகள் ராசிகளைப் பரிமாறிக் கொள்கிறார்கள் — காலப்போக்கில் இரு வீடுகளின் விவகாரங்களும் ஒன்றையொன்று மேம்படுத்துகின்றன.",
  "yogaKhalaParivartanaName": "கால பரிவர்தன யோகா",
  "yogaKhalaParivartanaMeaning": "மூன்றாம் வீடு சம்பந்தப்பட்ட ஒரு பரிமாற்றம் — கலவையான பலன்கள், ஏற்ற இறக்கங்கள், முயற்சி மற்றும் தைரியத்தின் மூலம் ஆதாயங்கள்.",
  "yogaDainyaParivartanaName": "தைன்ய பரிவர்தன யோகா",
  "yogaDainyaParivartanaMeaning": "கடினமான ஒரு வீட்டை உள்ளடக்கிய பரிமாற்றம் — பொறுமை தேவைப்படும் தடைகள்; ஒரு வலிமையான தசா அதை மாற்றிவிடும்.",
  "kSignAries": "துணிச்சலான, நேரடியான, விரைவாகத் தொடங்கும்",
  "kSignTaurus": "நிலையான, சிற்றின்ப உணர்வுள்ள, சுகம் மற்றும் பாதுகாப்பிற்கு மதிப்பளிப்பவர்",
  "kSignGemini": "ஆர்வமுள்ள, பேச்சுத் திறன் கொண்ட, விரைவாகச் சிந்திக்கும்",
  "kSignCancer": "அக்கறையுள்ள, பாதுகாப்பான, உணர்வால் வழிநடத்தப்படும்",
  "kSignLeo": "பெருமிதம், அன்பு, பிறரால் பார்க்கப்பட விரும்புகிறார்",
  "kSignVirgo": "துல்லியமான, பயனுள்ள, மேம்படுத்தும் நோக்கம் கொண்ட",
  "kSignLibra": "நியாயமான, உறவுகளைப் பேணும், சமநிலையை நாடும்",
  "kSignScorpio": "தீவிரமான, தனிப்பட்ட, எல்லாமே அல்லது ஒன்றுமே இல்லை",
  "kSignSagittarius": "சுதந்திரமான, நம்பிக்கையுள்ள, பரந்த கண்ணோட்டம்",
  "kSignCapricorn": "ஒழுக்கமான, லட்சியம் மிக்க, நீண்ட காலத் திட்டத்துடன் செயல்படுபவர்",
  "kSignAquarius": "சுதந்திரமான, அமைப்பு சார்ந்த, மரபுசாரா",
  "kSignPisces": "கற்பனைத்திறன் மிக்க, இரக்கமுள்ள, எல்லையற்ற",
  "kPlanetSun": "ஆன்மா, நம்பிக்கை, தந்தை, அதிகாரம்",
  "kPlanetMoon": "மனம், உணர்ச்சிகள், தாய், ஆறுதல்",
  "kPlanetMars": "உந்துதல், தைரியம், கோபம், உடன்பிறப்புகள்",
  "kPlanetMercury": "அறிவுத்திறன், பேச்சு, தொழில், திறமை",
  "kPlanetJupiter": "ஞானம், வளர்ச்சி, அதிர்ஷ்டம், ஆசிரியர்கள், குழந்தைகள்",
  "kPlanetVenus": "அன்பு, அழகு, ஆறுதல், கூட்டுறவு, கலை",
  "kPlanetSaturn": "ஒழுக்கம், நேரம், வரம்புகள், கடினமாகப் பெற்ற வெகுமதி",
  "kPlanetRahu": "லட்சியம், மோகம், அந்நிய மற்றும் புதிய",
  "kPlanetKetu": "பற்றின்மை, தேர்ச்சி, விட்டுக்கொடுத்தல், ஆன்மீகம்",
  "kHouse1": "சுயம், உடல், உயிர்சக்தி",
  "kHouse2": "செல்வம், குடும்பம், பேச்சு, உணவு",
  "kHouse3": "தைரியம், உடன்பிறப்புகள், முயற்சி, குறுகிய பயணம்",
  "kHouse4": "வீடு, தாய், நிலம், மன அமைதி",
  "kHouse5": "குழந்தைகள், கல்வி, படைப்பாற்றல், காதல்",
  "kHouse6": "உடல்நலம், கடன், எதிரிகள், அன்றாட வேலை",
  "kHouse7": "திருமணம், கூட்டாண்மை, வணிகம்",
  "kHouse8": "நீண்ட ஆயுள், திடீர் மாற்றம், மறைக்கப்பட்டவை, வாரிசுரிமை",
  "kHouse9": "செல்வம், தர்மம், தந்தை, உயர் கல்வி, நீண்ட பயணம்",
  "kHouse10": "தொழில், அந்தஸ்து, பொது வாழ்க்கை",
  "kHouse11": "வருமானம், ஆதாயங்கள், தொடர்பு வட்டம், மூத்த உடன்பிறப்புகள்",
  "kHouse12": "இழப்பு, செலவுகள், அயல்நாடுகள், உறக்கம், விடுதலை",
  "kDignityExalted": "மேன்மைப்படுத்தப்பட்ட — மிகவும் வலிமையான",
  "kDignityDebilitated": "பலவீனமடைந்துள்ளது — இங்கே அழுத்தத்தில் உள்ளது",
  "kDignityMoolatrikona": "மூலத்திரிகோனா — வசதியான மற்றும் வலிமையான",
  "kDignityOwn": "சொந்த ராசி — நிலையான மற்றும் பயனுள்ள",
  "kDignityGreatFriend": "ஒரு சிறந்த நண்பரின் அடையாளத்தில் — ஆதரிக்கப்பட்டது",
  "kDignityFriend": "நண்பரின் அடையாளத்தில் — ஆதரவு",
  "kDignityNeutral": "நடுநிலை அடையாளம்",
  "kDignityEnemy": "எதிரியின் ராசியில் இருந்தால் — கடினமாக உழைப்பார்.",
  "kDignityGreatEnemy": "பெரும் எதிரியின் அடையாளத்தில் — அழுத்தத்தின் கீழ்",
  "kDashaSun": "அடையாளம், அதிகாரம் மற்றும் அங்கீகாரத்திற்கான காலகட்டம். அகங்காரமும், கண்கள்/இதயத்தின் நலனும் கவனத்தில் கொள்ளப்படுகின்றன.",
  "kDashaMoon": "மென்மையான, அதிக உணர்ச்சிப்பூர்வமான ஒரு அத்தியாயம் — வீடு, தாய், மனநிலைகள் மற்றும் பொது வாழ்க்கை.",
  "kDashaMars": "ஆற்றல், போட்டி மற்றும் முன்முயற்சி அதிகரிக்கும். கோபம், விபத்துகள் மற்றும் சொத்து விஷயங்களைக் கவனியுங்கள்.",
  "kDashaMercury": "கற்றல், வர்த்தகம், எழுதுதல் மற்றும் தகவல் தொடர்பு. படிப்புக்கும் வணிகத்திற்கும் உகந்தது, அமைதியை விரும்பும் அமைதியற்றவர்.",
  "kDashaJupiter": "வளர்ச்சி, ஆசிரியர்கள், குடும்பம், வாழ்வின் அர்த்தம். பெரும்பாலும் ஒரு அதிர்ஷ்டமான, விரிவான காலகட்டம்.",
  "kDashaVenus": "உறவுகள், சுகம், கலை, பணம் மற்றும் இன்பம். பொதுவாக, காலகட்டங்களிலேயே இதுதான் மிகவும் எளிமையானது.",
  "kDashaSaturn": "கடின உழைப்பு, பொறுப்பு மற்றும் மெதுவான, நீடித்த பலன்கள். பொறுமைக்கு வெகுமதி அளிக்கிறது; குறுக்குவழிகளைத் தண்டிக்கிறது.",
  "kDashaRahu": "எல்லையற்ற லட்சியம் — அயல்நாடுகள், தொழில்நுட்பம், திடீர் உயர்வுகள் மற்றும் குழப்பம்.",
  "kDashaKetu": "பற்றின்மை, முடிவுகள் மற்றும் ஆன்மீக உள்நோக்கல். பௌதிகப் பொருட்கள் உள்ளீடற்றதாகத் தோன்றுகின்றன; திறமை ஆழமாகிறது.",
  "kNakAshwini": "விரைவான, முன்னோடியான, குணப்படுத்தும்",
  "kNakBharani": "தீவிரமான, மாற்றத்திற்கான இடமளிக்கும், ஒழுக்கமான",
  "kNakKrittika": "கூர்மையான, ஊடுருவிச் செல்லும், பாதுகாப்பான",
  "kNakRohini": "படைப்பாற்றல் மிக்க, சிற்றின்ப உணர்வுள்ள, அரவணைக்கும், காந்த சக்தி கொண்ட",
  "kNakMrigashira": "தேடும், ஆர்வமுள்ள, மென்மையான",
  "kNakArdra": "புயல் போன்ற, உருமாற்றும், நெருக்கடியான சூழ்நிலையிலும் அபாரமான திறமை",
  "kNakPunarvasu": "புதுப்பித்தல், தாராளமான, பாதுகாப்பிற்குத் திரும்புதல்",
  "kNakPushya": "ஊட்டமளிக்கும், கடமையுணர்வுள்ள, ஆழ்ந்த ஆதரவளிக்கும்",
  "kNakAshlesha": "கூர்மையான, வியூகமிக்க, மயக்கும்",
  "kNakMagha": "கம்பீரமான, மரபு சார்ந்த, மூதாதையர்",
  "kNakPurvaPhalguni": "விளையாட்டுத்தனமான, காதல் உணர்வுள்ள, ஓய்வை மதிக்கும்",
  "kNakUttaraPhalguni": "நம்பகமான, ஒப்பந்த அடிப்படையிலான, உதவிகரமான",
  "kNakHasta": "கைகளால் திறமையாக வேலை செய்பவர், புத்திசாலி, குணப்படுத்துபவர்",
  "kNakChitra": "கலைநயம் மிக்க, பிரமிக்க வைக்கும், அழகான பொருட்களை உருவாக்குகிறார்",
  "kNakSwati": "சுதந்திரமான, சூழ்நிலைக்கேற்ப தன்னை மாற்றிக்கொள்ளும், சுதந்திரத்தை விரும்பும்",
  "kNakVishakha": "குறிக்கோள் சார்ந்த, உறுதியான, இரட்டை இயல்புடைய",
  "kNakAnuradha": "அர்ப்பணிப்புள்ள, நட்பான, வெளிநாடுகளில் சிறந்து விளங்கும்",
  "kNakJyeshtha": "மூத்த, பொறுப்புள்ள, சுமைகளைச் சுமக்கிறார்",
  "kNakMula": "மூலத்தைத் தேடும், தீவிரமான, மையத்தை ஊடுருவும்",
  "kNakPurvaAshadha": "வெல்ல முடியாத மன உறுதி, இணங்க வைக்கும் திறன்",
  "kNakUttaraAshadha": "கொள்கைப்பிடிப்புள்ள, நீடித்த, பிற்கால வெற்றி",
  "kNakShravana": "கவனித்தல், கற்றல், மக்களை இணைத்தல்",
  "kNakDhanishta": "தாளம் சார்ந்த, செல்வந்த, இசை சார்ந்த, தகவமைத்துக் கொள்ளக்கூடிய",
  "kNakShatabhisha": "தனிப்பட்ட, குணப்படுத்தும், அமைப்பு சார்ந்த",
  "kNakPurvaBhadrapada": "இலட்சியவாத, தீவிரமான, மாற்றத்தை உண்டாக்கும்",
  "kNakUttaraBhadrapada": "ஆழ்ந்த, அமைதியான, ஞானமான ஆலோசனை",
  "kNakRevati": "அன்பான, பயணிகளைப் பாதுகாக்கும், கற்பனைத்திறன் மிக்க",
  "kSadeSatiRising": "உதயமாகும் பருவம் — உங்கள் சந்திரனிலிருந்து 12-வது ராசியில் சனி உள்ளது. முடிவுகள், சோர்வு மற்றும் காரியங்கள் முடிவுக்கு வரும் உணர்வு. இனி பயனளிக்காதவற்றை அகற்றத் தொடங்குங்கள்.",
  "kSadeSatiPeak": "உச்சக்கட்டம் — சனி உங்கள் சந்திர ராசிக்கு நேர் மேலே உள்ளது. மிகக் கடுமையான காலகட்டம்: பொறுப்பு, அழுத்தம் மற்றும் மெதுவான முன்னேற்றம். வழக்கமான நடைமுறைகளைப் பின்பற்றுங்கள், உங்கள் ஆரோக்கியத்தைப் பாதுகாத்துக் கொள்ளுங்கள்.",
  "kSadeSatiSetting": "அஸ்தமன காலம் — உங்கள் சந்திரனிலிருந்து இரண்டாவது ராசியில் சனி உள்ளது. மனச்சுமை நீங்கும். பணமும் குடும்பமும் நிலைபெறும்; கடந்த ஆண்டுகளின் பாடங்கள் பலனளிக்கத் தொடங்கும்.",
  "kSadeSatiGeneric": "சனி உங்கள் சந்திரனைச் சுற்றி ராசிகளில் சஞ்சரிக்கிறது.",
