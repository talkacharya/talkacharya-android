  "yogaGajakesariMeaning": "ಚಂದ್ರನಿಂದ ಕೇಂದ್ರದಲ್ಲಿ ಗುರು - ಸಮತೋಲನ, ಉತ್ತಮ ತೀರ್ಪು ಮತ್ತು ತೂಕವನ್ನು ಹೊಂದಿರುವ ಹೆಸರು.",
  "yogaBudhadityaName": "ಬುಧಾದಿತ್ಯ ಯೋಗ",
  "yogaBudhadityaMeaning": "ಸೂರ್ಯ ಮತ್ತು ಬುಧ ಒಟ್ಟಿಗೆ - ತೀಕ್ಷ್ಣವಾದ, ಅಭಿವ್ಯಕ್ತಿಶೀಲ ಮನಸ್ಸು; ಅಧ್ಯಯನ, ಬರವಣಿಗೆ ಮತ್ತು ವಿಶ್ಲೇಷಣೆಗೆ ಬಲಿಷ್ಠ.",
  "yogaChandraMangalaName": "ಚಂದ್ರ-ಮಂಗಳ ಯೋಗ",
  "yogaChandraMangalaMeaning": "ಮಂಗಳನೊಂದಿಗೆ ಚಂದ್ರ - ಹಣ ಮತ್ತು ಉದ್ಯಮದ ಸುತ್ತ ಚಾಲನೆ; ಪ್ರಯತ್ನ ಮತ್ತು ಉಪಕ್ರಮದ ಮೂಲಕ ಗಳಿಕೆ.",
  "yogaRajaName": "ರಾಜ ಯೋಗ",
  "yogaRajaMeaning": "ತ್ರಿಕೋನ ಅಧಿಪತಿಗೆ ಬಂಧಿಸಲಾದ ಕೇಂದ್ರ ಅಧಿಪತಿ - ಅವಧಿ ಮುಗಿದಾಗ ಸ್ಥಾನಮಾನ, ಅಧಿಕಾರ ಮತ್ತು ಅವಕಾಶದಲ್ಲಿ ಏರಿಕೆ.",
  "yogaDhanaName": "ಧನ ಯೋಗ",
  "yogaDhanaMeaning": "ಸಂಪತ್ತು ಮತ್ತು ಲಾಭಗಳು ಮನೆಗಳಿಗೆ ಸಂಬಂಧಿಸಿವೆ - ಉಳಿತಾಯ ಮತ್ತು ಸ್ಥಿರ ಆರ್ಥಿಕ ಬೆಳವಣಿಗೆಯನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ.",
  "yogaNeechabhangaName": "ನೀಚಭಂಗ ರಾಜ ಯೋಗ",
  "yogaNeechabhangaMeaning": "ದುರ್ಬಲಗೊಂಡ ಗ್ರಹ, ಅದರ ದೌರ್ಬಲ್ಯವು ರದ್ದಾಗುತ್ತದೆ - ಆರಂಭಿಕ ಹೋರಾಟವು ಬಲವಾಗಿ ಬದಲಾಗುತ್ತದೆ.",
  "yogaKaalSarpaName": "ಕಾಲ ಸರ್ಪ ಯೋಗ",
  "yogaKaalSarpaMeaning": "ರಾಹು-ಕೇತು ಅಕ್ಷದ ಒಂದು ಬದಿಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಏಳು ಗ್ರಹಗಳು - ಸ್ಪಷ್ಟ ದಿಕ್ಕು ಕಂಡುಬರುವವರೆಗೆ ಜೀವನವು ಸೀಮಿತವಾಗಿರಬಹುದು.",
  "yogaAdhiName": "ಅಧಿ ಯೋಗ",
  "yogaAdhiMeaning": "ಚಂದ್ರನಿಂದ 6ನೇ, 7ನೇ ಮತ್ತು 8ನೇ ಮನೆಯಲ್ಲಿ ಶುಭಫಲಗಳು - ರಕ್ಷಣೆ, ಸಮರ್ಥ ಸಹಾಯಕರು ಮತ್ತು ಸ್ಥಿರ ಸ್ಥಾನ.",
  "yogaShakataName": "ಶಕಟ ಯೋಗ",
  "yogaShakataMeaning": "ಗುರು ಗ್ರಹದಿಂದ 6, 8 ಅಥವಾ 12ನೇ ಮನೆಯಲ್ಲಿ ಚಂದ್ರ - ಏರಿಳಿತಗೊಳ್ಳುವ ಅದೃಷ್ಟ; ಚಂದ್ರ ಬಲವಾಗಿದ್ದಾಗ ಸ್ಥಿರವಾಗಿರುತ್ತದೆ.",
  "yogaVishName": "ವಿಷ್ ಯೋಗಾ",
  "yogaVishMeaning": "ಶನಿಯೊಂದಿಗೆ ಚಂದ್ರ - ಮನಸ್ಸು ಭಾರವನ್ನು ಹೊರುತ್ತದೆ; ಫಲಿತಾಂಶಗಳು ಸಾಮಾನ್ಯವಾಗಿ ನಂತರ, ಪ್ರಬುದ್ಧತೆಯೊಂದಿಗೆ ಬರುತ್ತವೆ.",
  "yogaKahalaName": "ಕಹಲ ಯೋಗ",
  "yogaKahalaMeaning": "ಬಲವಾದ ಲಗ್ನಾಧಿಪತಿಯೊಂದಿಗೆ ಪರಸ್ಪರ ಕೇಂದ್ರದಲ್ಲಿ 4 ಮತ್ತು 9 ನೇ ಅಧಿಪತಿಗಳು - ಧೈರ್ಯಶಾಲಿ, ಉದ್ಯಮಶೀಲ, ಅಪಾಯವನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು ಸಿದ್ಧರಿರುವವರು.",
  "yogaPushkalaName": "ಪುಷ್ಕಲಾ ಯೋಗ",
  "yogaPushkalaMeaning": "ಚಂದ್ರನ ಅಧಿಪತಿಯು ಲಗ್ನಾಧಿಪತಿ ಕೇಂದ್ರದಲ್ಲಿ — ಗೌರವ, ಒಳ್ಳೆಯ ಹೆಸರು ಮತ್ತು ಮನವೊಲಿಸುವ ಮಾತು.",
  "yogaDaridraName": "ದರಿದ್ರ ಯೋಗ",
  "yogaDaridraMeaning": "11 ನೇ (ಲಾಭ) ಅಧಿಪತಿಯು ಕಠಿಣ ಮನೆಗೆ ಬಿದ್ದಿದ್ದಾನೆ - ಲಾಭಗಳು ನಿಧಾನವಾಗಿ ಬರುತ್ತವೆ; ಬಲವಾದ ದಶಾ ಅದನ್ನು ತಿರುಗಿಸುತ್ತದೆ.",
  "yogaAmalaName": "ಅಮಲ ಯೋಗ",
  "yogaAmalaMeaning": "ಲಗ್ನ ಅಥವಾ ಚಂದ್ರನಿಂದ 10ನೇ ಮನೆಯಲ್ಲಿ ಶುಭ - ಶುದ್ಧ ಖ್ಯಾತಿ ಮತ್ತು ಶಾಶ್ವತ ಸದ್ಭಾವನೆ.",
  "yogaSaraswatiName": "ಸರಸ್ವತಿ ಯೋಗ",
  "yogaSaraswatiMeaning": "ಬುಧ, ಶುಕ್ರ ಮತ್ತು ಬಲಿಷ್ಠ ಗುರು ಉತ್ತಮ ಸ್ಥಾನದಲ್ಲಿದ್ದಾರೆ - ಕಲಿಕೆ, ಕಲೆ ಮತ್ತು ವಾಗ್ಮಿತೆ.",
  "yogaLakshmiName": "ಲಕ್ಷ್ಮಿ ಯೋಗಾ",
  "yogaLakshmiMeaning": "ಕೇಂದ್ರ ಅಥವಾ ತ್ರಿಕೋನದಲ್ಲಿ ಬಲಿಷ್ಠ 9ನೇ ಅಧಿಪತಿಯು ಬಲಿಷ್ಠ ಲಗ್ನಾಧಿಪತಿಯೊಂದಿಗೆ - ಅದೃಷ್ಟ, ಸೌಕರ್ಯ ಮತ್ತು ಅನುಗ್ರಹ.",
  "yogaRuchakaName": "ರುಚಕ ಯೋಗ",
  "yogaRuchakaMeaning": "ಮಂಗಳ ಕೇಂದ್ರದಲ್ಲಿ ಬಲಶಾಲಿ - ಧೈರ್ಯ, ದೈಹಿಕ ಶಕ್ತಿ ಮತ್ತು ಒತ್ತಡದಲ್ಲಿ ನಾಯಕತ್ವ.",
  "yogaBhadraName": "ಭದ್ರ ಯೋಗ",
  "yogaBhadraMeaning": "ಕೇಂದ್ರದಲ್ಲಿ ಬುಧ ಬಲಶಾಲಿ — ಬುದ್ಧಿವಂತಿಕೆ, ಸ್ಪಷ್ಟ ಮಾತು ಮತ್ತು ವ್ಯಾಪಾರ ಮತ್ತು ಸಂವಹನದಲ್ಲಿ ಕೌಶಲ್ಯ.",
  "yogaHamsaName": "ಹಂಸ ಯೋಗ",
  "yogaHamsaMeaning": "ಕೇಂದ್ರದಲ್ಲಿ ಗುರು ಬಲಶಾಲಿ - ಬುದ್ಧಿವಂತಿಕೆ, ನೀತಿಶಾಸ್ತ್ರ, ಬೋಧನೆ ಅಥವಾ ಸಲಹೆ ನೀಡುವ ಸ್ವಭಾವ ಮತ್ತು ಸಾಮಾನ್ಯ ಅದೃಷ್ಟ.",
  "yogaMalavyaName": "ಮಾಲವ್ಯ ಯೋಗ",
  "yogaMalavyaMeaning": "ಕೇಂದ್ರದಲ್ಲಿ ಶುಕ್ರ ಬಲಶಾಲಿ - ಮೋಡಿ, ಸೌಕರ್ಯ, ಸೌಂದರ್ಯದ ಕಣ್ಣು ಮತ್ತು ಆಹ್ಲಾದಕರ ಗೃಹ ಜೀವನ.",
  "yogaSasaName": "ಸಸ ಯೋಗ",
  "yogaSasaMeaning": "ಕೇಂದ್ರದಲ್ಲಿ ಬಲಿಷ್ಠವಾಗಿರುವ ಶನಿ - ಶಿಸ್ತು, ಸಹಿಷ್ಣುತೆ ಮತ್ತು ಅಧಿಕಾರ ನಿಧಾನವಾಗಿ ನಿರ್ಮಿಸಲ್ಪಟ್ಟಿದೆ ಮತ್ತು ನಿರ್ವಹಿಸಲ್ಪಡುತ್ತದೆ.",
  "yogaUbhayachariName": "ಉಭಯಚಾರಿ ಯೋಗ",
  "yogaUbhayachariMeaning": "ಸೂರ್ಯನ ಎರಡೂ ಬದಿಗಳಲ್ಲಿರುವ ಗ್ರಹಗಳು - ಉತ್ತಮ ಬೆಂಬಲಿತ, ಗೋಚರ ಜೀವನ ಮತ್ತು ಉತ್ತಮ ಸರ್ವತೋಮುಖ ನಿಲುವು.",
  "yogaVesiName": "ವೆಸಿ ಯೋಗ",
  "yogaVesiMeaning": "ಸೂರ್ಯನಿಂದ 2 ನೇ ಮನೆಯಲ್ಲಿ ಗ್ರಹ - ಸ್ಥಿರ ಮಾತು, ಸಮತೋಲಿತ ದೃಷ್ಟಿಕೋನ ಮತ್ತು ಉತ್ತಮ ಹೆಸರು.",
  "yogaVasiName": "ವಾಸಿ ಯೋಗ",
  "yogaVasiMeaning": "ಸೂರ್ಯನಿಂದ 12ನೇ ಮನೆಯಲ್ಲಿ ಗ್ರಹ - ಸಾಮರ್ಥ್ಯ, ಪ್ರಭಾವ ಮತ್ತು ಉದಾರ ಗುಣ.",
  "yogaShubhaKartariName": "ಶುಭ ಕರ್ತಾರಿ ಯೋಗ",
  "yogaShubhaKartariMeaning": "ಲಗ್ನದ ಎರಡೂ ಬದಿಗಳಲ್ಲಿ ಶುಭಫಲಗಳು - ರಕ್ಷಣೆ, ಸೌಮ್ಯ ಮಾರ್ಗ ಮತ್ತು ಸಹಾಯಕವಾದ ಸಂದರ್ಭಗಳು.",
  "yogaPapaKartariName": "ಪಾಪಾ ಕರ್ತಾರಿ ಯೋಗ",
  "yogaPapaKartariMeaning": "ಲಗ್ನದ ಎರಡೂ ಬದಿಗಳಲ್ಲಿ ದೋಷಗಳು - ಸ್ವಯಂ ಮತ್ತು ಆರೋಗ್ಯದ ಮೇಲೆ ಒತ್ತಡ; ನಿಮ್ಮ ಶಕ್ತಿ ಮತ್ತು ಗಡಿಗಳನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳಿ.",
  "yogaDurudharaName": "ದುರುಧಾರ ಯೋಗ",
  "yogaDurudharaMeaning": "ಗ್ರಹಗಳು 2 ಮತ್ತು 12 ನೇ ಸ್ಥಾನದಲ್ಲಿ ಚಂದ್ರನ ಪಕ್ಕದಲ್ಲಿವೆ - ನಿಮ್ಮ ಸುತ್ತಲಿನ ಸಂಪನ್ಮೂಲಗಳು, ಸೌಕರ್ಯ ಮತ್ತು ಸ್ಥಿರ ಬೆಂಬಲ.",
  "yogaSunaphaName": "ಸುನಫ ಯೋಗ",
  "yogaSunaphaMeaning": "ಚಂದ್ರನಿಂದ 2 ನೇ ಮನೆಯಲ್ಲಿ ಇರುವ ಗ್ರಹ - ಸ್ವ-ನಿರ್ಮಿತ ಸಾಧನ, ಬುದ್ಧಿವಂತಿಕೆ ಮತ್ತು ಒಳ್ಳೆಯ ಹೆಸರು.",
  "yogaAnaphaName": "ಅನಫ ಯೋಗ",
  "yogaAnaphaMeaning": "ಚಂದ್ರನಿಂದ 12 ನೇ ಮನೆಯಲ್ಲಿ ಇರುವ ಗ್ರಹ - ಸುಲಭ ಸ್ವಭಾವ, ಯೋಗಕ್ಷೇಮ ಮತ್ತು ಬಡತನದಿಂದ ಮುಕ್ತಿ.",
  "yogaKemadrumaYogaName": "ಕೇಮದ್ರುಮ ಯೋಗ",
  "yogaKemadrumaYogaMeaning": "ಚಂದ್ರನು ಬೆಂಬಲವಿಲ್ಲದೆ ಒಂಟಿಯಾಗಿ ನಿಲ್ಲುತ್ತಾನೆ - ಚಂದ್ರನು ಬಲವಾಗಿದ್ದಾಗ ಅಥವಾ ಒಂದು ಕೇಂದ್ರವು ಕಾರ್ಯನಿರತವಾಗಿದ್ದಾಗ ಶಮನವಾಗುವ ಆಂತರಿಕ ಚಡಪಡಿಕೆ.",
  "yogaVasumatiName": "ವಸುಮತಿ ಯೋಗ",
  "yogaVasumatiMeaning": "ಲಗ್ನ ಅಥವಾ ಚಂದ್ರನಿಂದ ಬೆಳವಣಿಗೆಯ ಮನೆಗಳಲ್ಲಿ ಶುಭಫಲಗಳು - ಸಂಪತ್ತು ಸಂಗ್ರಹವಾಗುವುದು ಮತ್ತು ಸಂಪನ್ಮೂಲಗಳು ಹೆಚ್ಚಾಗುವುದು.",
  "yogaKalanidhiName": "ಕಲಾನಿಧಿ ಯೋಗ",
  "yogaKalanidhiMeaning": "2 ಅಥವಾ 5 ನೇ ಮನೆಯಲ್ಲಿ ಗುರು ಬುಧ ಅಥವಾ ಶುಕ್ರನೊಂದಿಗೆ ಸಂಬಂಧ ಹೊಂದಿದ್ದಾನೆ - ಕಲಿಕೆ, ಕಲೆಗಳು, ಸುಧಾರಣೆ ಮತ್ತು ಗೌರವ.",
  "yogaChamaraName": "ಚಾಮರ ಯೋಗ",
  "yogaChamaraMeaning": "ಗುರುವಿನ ದೃಷ್ಟಿಯಲ್ಲಿರುವ ಕೇಂದ್ರದಲ್ಲಿ ಲಗ್ನಾಧಿಪತಿ ಉತ್ತುಂಗಕ್ಕೇರಿದ್ದಾನೆ - ವಾಗ್ಮಿತೆ, ದೀರ್ಘಾಯುಷ್ಯ ಮತ್ತು ಗೌರವಾನ್ವಿತ ಸ್ಥಾನ.",
  "yogaShankhaName": "ಶಂಖ ಯೋಗ",
  "yogaShankhaMeaning": "5 ನೇ ಮತ್ತು 6 ನೇ ಅಧಿಪತಿಗಳು ಬಲವಾದ ಲಗ್ನಾಧಿಪತಿಯೊಂದಿಗೆ ಸಂಬಂಧ ಹೊಂದಿದ್ದಾರೆ - ಉತ್ತಮ ಜೀವನ, ದಯೆಯ ಸ್ವಭಾವ ಮತ್ತು ನಂತರದ ವರ್ಷಗಳಲ್ಲಿ ಸೌಕರ್ಯ.",
  "yogaParvataName": "ಪರ್ವತ ಯೋಗ",
  "yogaParvataMeaning": "6 ನೇ ಮತ್ತು 8 ನೇ ವಾಸಸ್ಥಾನವು ಶುದ್ಧವಾಗಿರುವ ಕೇಂದ್ರಗಳಲ್ಲಿ ಲಾಭಕಾರರು - ಅದೃಷ್ಟ, ಔದಾರ್ಯ ಮತ್ತು ಶ್ರೇಷ್ಠ ಹೆಸರು.",
  "yogaHarshaName": "ಹರ್ಷ ಯೋಗಾ",
  "yogaHarshaMeaning": "ಕಠಿಣ ಮನೆಯಲ್ಲಿ 6 ನೇ ಅಧಿಪತಿ - ಶತ್ರುಗಳು, ಸಾಲಗಳು ಮತ್ತು ಅನಾರೋಗ್ಯವು ತಮ್ಮ ಹಿಡಿತವನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತದೆ; ಸ್ಪರ್ಧಾತ್ಮಕ ಶಕ್ತಿ.",
  "yogaSaralaName": "ಸರಳಾ ಯೋಗಾ",
  "yogaSaralaMeaning": "ಕಠಿಣ ಮನೆಯಲ್ಲಿ 8 ನೇ ಅಧಿಪತಿ - ಬಿಕ್ಕಟ್ಟುಗಳ ಮೂಲಕ ಸ್ಥಿತಿಸ್ಥಾಪಕತ್ವ, ದೀರ್ಘಾಯುಷ್ಯ ಮತ್ತು ನಿರ್ಭಯತೆ.",
  "yogaVimalaName": "ವಿಮಲ ಯೋಗ",
  "yogaVimalaMeaning": "ಕಠಿಣ ಮನೆಯಲ್ಲಿ 12 ನೇ ಅಧಿಪತಿ — ನಿಯಂತ್ರಿತ ಖರ್ಚು, ಶುದ್ಧ ಮನಸ್ಸಾಕ್ಷಿ ಮತ್ತು ಸ್ವತಂತ್ರ ಜೀವನ.",
  "yogaMahaParivartanaName": "ಮಹಾ ಪರಿವರ್ತನಾ ಯೋಗ",
  "yogaMahaParivartanaMeaning": "ಒಳ್ಳೆಯ ಮನೆಗಳ ಇಬ್ಬರು ಅಧಿಪತಿಗಳು ಚಿಹ್ನೆಗಳನ್ನು ವಿನಿಮಯ ಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ - ಎರಡೂ ಮನೆಗಳ ವ್ಯವಹಾರಗಳು ಕಾಲಾನಂತರದಲ್ಲಿ ಪರಸ್ಪರ ಎತ್ತುತ್ತವೆ.",
  "yogaKhalaParivartanaName": "ಖಲ ಪರಿವರ್ತನಾ ಯೋಗ",
  "yogaKhalaParivartanaMeaning": "3 ನೇ ಮನೆಯನ್ನು ಒಳಗೊಂಡ ವಿನಿಮಯ - ಮಿಶ್ರ ಫಲಿತಾಂಶಗಳು, ಏರಿಳಿತಗಳು, ಪ್ರಯತ್ನ ಮತ್ತು ಧೈರ್ಯದಿಂದ ಲಾಭಗಳು.",
  "yogaDainyaParivartanaName": "ದೈನ್ಯ ಪರಿವರ್ತನಾ ಯೋಗ",
  "yogaDainyaParivartanaMeaning": "ಕಷ್ಟಕರವಾದ ಮನೆಯನ್ನು ಒಳಗೊಂಡ ವಿನಿಮಯ - ತಾಳ್ಮೆ ಅಗತ್ಯವಿರುವ ಅಡೆತಡೆಗಳು; ಬಲವಾದ ದಶಾ ಅದನ್ನು ತಿರುಗಿಸುತ್ತದೆ.",
  "kSignAries": "ದಪ್ಪ, ನೇರ, ತ್ವರಿತವಾಗಿ ಪ್ರಾರಂಭಿಸಿ",
  "kSignTaurus": "ಸ್ಥಿರ, ಇಂದ್ರಿಯ, ಸೌಕರ್ಯ ಮತ್ತು ಭದ್ರತೆಯನ್ನು ಮೌಲ್ಯೀಕರಿಸುತ್ತದೆ",
  "kSignGemini": "ಕುತೂಹಲ, ಮಾತಿನ, ಚುರುಕಾಗಿ ಯೋಚಿಸುವ",
  "kSignCancer": "ಕಾಳಜಿಯುಳ್ಳ, ರಕ್ಷಣಾತ್ಮಕ, ಭಾವನೆಯಿಂದ ನಡೆಸಲ್ಪಡುವ",
  "kSignLeo": "ಹೆಮ್ಮೆ, ಆತ್ಮೀಯತೆ, ನೋಡಲು ಬಯಸುತ್ತೇನೆ",
  "kSignVirgo": "ನಿಖರ, ಉಪಯುಕ್ತ, ಸುಧಾರಣಾ ಮನೋಭಾವದ",
  "kSignLibra": "ನ್ಯಾಯಯುತ, ಸಂಬಂಧಾತ್ಮಕ, ಸಮತೋಲನವನ್ನು ಬಯಸುತ್ತದೆ",
  "kSignScorpio": "ತೀವ್ರ, ಖಾಸಗಿ, ಎಲ್ಲವೂ ಅಥವಾ ಏನೂ ಇಲ್ಲ",
  "kSignSagittarius": "ಸ್ವತಂತ್ರ, ನಂಬಿಕೆಯುಳ್ಳ, ದೊಡ್ಡ ಚಿತ್ರಣ",
  "kSignCapricorn": "ಶಿಸ್ತುಬದ್ಧ, ಮಹತ್ವಾಕಾಂಕ್ಷೆಯುಳ್ಳ, ದೀರ್ಘ ಆಟವನ್ನು ಆಡುವ",
  "kSignAquarius": "ಸ್ವತಂತ್ರ, ವ್ಯವಸ್ಥೆ-ಮನಸ್ಸಿನ, ಅಸಾಂಪ್ರದಾಯಿಕ",
  "kSignPisces": "ಕಲ್ಪನಾತ್ಮಕ, ಕರುಣಾಮಯ, ಮಿತಿಯಿಲ್ಲದ",
  "kPlanetNameSun": "Sun",
  "kPlanetNameMoon": "Moon",
  "kPlanetNameMars": "Mars",
  "kPlanetNameMercury": "Mercury",
  "kPlanetNameJupiter": "Jupiter",
  "kPlanetNameVenus": "Venus",
  "kPlanetNameSaturn": "Saturn",
  "kPlanetNameRahu": "Rahu",
  "kPlanetNameKetu": "Ketu",
  "kPlanetSun": "ಆತ್ಮ, ವಿಶ್ವಾಸ, ತಂದೆ, ಅಧಿಕಾರ",
  "kPlanetMoon": "ಮನಸ್ಸು, ಭಾವನೆಗಳು, ತಾಯಿ, ಸಾಂತ್ವನ",
  "kPlanetMars": "ಚಾಲನೆ, ಧೈರ್ಯ, ಕೋಪ, ಒಡಹುಟ್ಟಿದವರು",
  "kPlanetMercury": "ಬುದ್ಧಿಶಕ್ತಿ, ಮಾತು, ವ್ಯಾಪಾರ, ಕೌಶಲ್ಯ",
  "kPlanetJupiter": "ಬುದ್ಧಿವಂತಿಕೆ, ಬೆಳವಣಿಗೆ, ಅದೃಷ್ಟ, ಶಿಕ್ಷಕರು, ಮಕ್ಕಳು",
  "kPlanetVenus": "ಪ್ರೀತಿ, ಸೌಂದರ್ಯ, ಸೌಕರ್ಯ, ಪಾಲುದಾರಿಕೆ, ಕಲೆ",
  "kPlanetSaturn": "ಶಿಸ್ತು, ಸಮಯ, ಮಿತಿಗಳು, ಕಷ್ಟಪಟ್ಟು ಗಳಿಸಿದ ಪ್ರತಿಫಲ",
  "kPlanetRahu": "ಮಹತ್ವಾಕಾಂಕ್ಷೆ, ಗೀಳು, ವಿದೇಶಿ ಮತ್ತು ಹೊಸದು",
  "kPlanetKetu": "ನಿರ್ಲಿಪ್ತತೆ, ಪಾಂಡಿತ್ಯ, ಬಿಟ್ಟುಬಿಡುವುದು, ಆಧ್ಯಾತ್ಮಿಕತೆ",
  "kHouse1": "ಆತ್ಮ, ದೇಹ, ಚೈತನ್ಯ",
  "kHouse2": "ಸಂಪತ್ತು, ಕುಟುಂಬ, ಮಾತು, ಆಹಾರ",
  "kHouse3": "ಧೈರ್ಯ, ಒಡಹುಟ್ಟಿದವರು, ಪ್ರಯತ್ನ, ಸಣ್ಣ ಪ್ರಯಾಣ",
  "kHouse4": "ಮನೆ, ತಾಯಿ, ಭೂಮಿ, ಆಂತರಿಕ ಶಾಂತಿ",
  "kHouse5": "ಮಕ್ಕಳು, ಶಿಕ್ಷಣ, ಸೃಜನಶೀಲತೆ, ಪ್ರಣಯ",
  "kHouse6": "ಆರೋಗ್ಯ, ಸಾಲ, ಶತ್ರುಗಳು, ದೈನಂದಿನ ಕೆಲಸ",
  "kHouse7": "ಮದುವೆ, ಪಾಲುದಾರಿಕೆ, ವ್ಯವಹಾರ",
  "kHouse8": "ದೀರ್ಘಾಯುಷ್ಯ, ಹಠಾತ್ ಬದಲಾವಣೆ, ಗುಪ್ತ, ಆನುವಂಶಿಕತೆ",
  "kHouse9": "ಅದೃಷ್ಟ, ಧರ್ಮ, ತಂದೆ, ಉನ್ನತ ಶಿಕ್ಷಣ, ದೀರ್ಘ ಪ್ರಯಾಣ",
  "kHouse10": "ವೃತ್ತಿ, ಸ್ಥಾನಮಾನ, ಸಾರ್ವಜನಿಕ ಜೀವನ",
  "kHouse11": "ಆದಾಯ, ಲಾಭಗಳು, ನೆಟ್‌ವರ್ಕ್, ಅಣ್ಣ-ತಂಗಿಯರು",
  "kHouse12": "ನಷ್ಟ, ಖರ್ಚುಗಳು, ವಿದೇಶಿ ಭೂಮಿ, ನಿದ್ರೆ, ಮುಕ್ತಿ",
  "kDignityExalted": "ಉದಾತ್ತ - ಬಹಳ ಬಲಶಾಲಿ",
  "kDignityDebilitated": "ದುರ್ಬಲ — ಇಲ್ಲಿ ಒತ್ತಡದಲ್ಲಿದೆ",
  "kDignityMoolatrikona": "ಮೂಲತ್ರಿಕೋನ — ಆರಾಮದಾಯಕ ಮತ್ತು ಬಲವಾದ",
  "kDignityOwn": "ಸ್ವಂತ ಚಿಹ್ನೆ — ಸ್ಥಿರ ಮತ್ತು ಪರಿಣಾಮಕಾರಿ",
  "kDignityGreatFriend": "ಉತ್ತಮ ಸ್ನೇಹಿತನ ಚಿಹ್ನೆಯಲ್ಲಿ — ಬೆಂಬಲಿತವಾಗಿದೆ",
  "kDignityFriend": "ಸ್ನೇಹಿತನ ಚಿಹ್ನೆಯಲ್ಲಿ — ಬೆಂಬಲಿತವಾಗಿದೆ",
  "kDignityNeutral": "ತಟಸ್ಥ ಚಿಹ್ನೆ",
  "kDignityEnemy": "ಶತ್ರುವಿನ ಚಿಹ್ನೆಯಲ್ಲಿ — ಹೆಚ್ಚು ಶ್ರಮಿಸುತ್ತದೆ",
  "kDignityGreatEnemy": "ದೊಡ್ಡ ಶತ್ರುವಿನ ಚಿಹ್ನೆಯಲ್ಲಿ — ಒತ್ತಡದಲ್ಲಿ",
  "kDashaSun": "ಗುರುತು, ಅಧಿಕಾರ ಮತ್ತು ಮನ್ನಣೆಗೆ ಒಂದು ಅವಧಿ. ಕಣ್ಣುಗಳು/ಹೃದಯದ ಅಹಂ ಮತ್ತು ಆರೋಗ್ಯವು ಗಮನಕ್ಕೆ ಬರುತ್ತದೆ.",
  "kDashaMoon": "ಮೃದುವಾದ, ಹೆಚ್ಚು ಭಾವನಾತ್ಮಕ ಅಧ್ಯಾಯ - ಮನೆ, ತಾಯಿ, ಮನಸ್ಥಿತಿಗಳು ಮತ್ತು ಸಾರ್ವಜನಿಕ ಜೀವನ.",
  "kDashaMars": "ಶಕ್ತಿ, ಸ್ಪರ್ಧೆ ಮತ್ತು ಉಪಕ್ರಮ ಹೆಚ್ಚಾಗುತ್ತದೆ. ಕೋಪ, ಅಪಘಾತಗಳು ಮತ್ತು ಆಸ್ತಿ ವಿಷಯಗಳಲ್ಲಿ ನಿಗಾ ಇರಿಸಿ.",
  "kDashaMercury": "ಕಲಿಕೆ, ವ್ಯಾಪಾರ, ಬರವಣಿಗೆ ಮತ್ತು ಸಂವಹನ. ಅಧ್ಯಯನ ಮತ್ತು ವ್ಯವಹಾರಕ್ಕೆ ಒಳ್ಳೆಯದು, ನಿಶ್ಚಲತೆಗೆ ಚಡಪಡಿಕೆ.",
  "kDashaJupiter": "ಬೆಳವಣಿಗೆ, ಶಿಕ್ಷಕರು, ಕುಟುಂಬ, ಅರ್ಥ. ಆಗಾಗ್ಗೆ ಅದೃಷ್ಟದ, ವಿಸ್ತಾರವಾದ ಹಂತ.",
  "kDashaVenus": "ಸಂಬಂಧಗಳು, ಸೌಕರ್ಯ, ಕಲೆ, ಹಣ ಮತ್ತು ಸಂತೋಷ. ಸಾಮಾನ್ಯವಾಗಿ ಋತುಚಕ್ರಗಳಲ್ಲಿ ಅತ್ಯಂತ ಸುಲಭವಾದದ್ದು.",
  "kDashaSaturn": "ಕಠಿಣ ಪರಿಶ್ರಮ, ಜವಾಬ್ದಾರಿ ಮತ್ತು ನಿಧಾನ, ಶಾಶ್ವತ ಫಲಿತಾಂಶಗಳು. ತಾಳ್ಮೆಗೆ ಪ್ರತಿಫಲ ನೀಡುತ್ತದೆ; ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ಶಿಕ್ಷಿಸುತ್ತದೆ.",
  "kDashaRahu": "ಮಿತಿಯಿಲ್ಲದ ಮಹತ್ವಾಕಾಂಕ್ಷೆ - ವಿದೇಶಿ ನೆಲ, ತಂತ್ರಜ್ಞಾನ, ಹಠಾತ್ ಏರಿಕೆ ಮತ್ತು ಗೊಂದಲ.",
  "kDashaKetu": "ನಿರ್ಲಿಪ್ತತೆ, ಅಂತ್ಯಗಳು ಮತ್ತು ಆಧ್ಯಾತ್ಮಿಕ ಒಳಮುಖ ತಿರುಗುವಿಕೆ. ಭೌತಿಕ ವಸ್ತುಗಳು ಟೊಳ್ಳಾಗಿವೆ ಎಂದು ಭಾಸವಾಗುತ್ತದೆ; ಕೌಶಲ್ಯವು ಆಳವಾಗುತ್ತದೆ.",
  "kNakAshwini": "ತ್ವರಿತ, ಪ್ರವರ್ತಕ, ಗುಣಪಡಿಸುವುದು",
  "kNakBharani": "ತೀವ್ರ, ಬದಲಾವಣೆಗೆ ಜಾಗವಿದೆ, ಶಿಸ್ತುಬದ್ಧ",
  "kNakKrittika": "ತೀಕ್ಷ್ಣ, ಕತ್ತರಿಸುವ, ರಕ್ಷಣಾತ್ಮಕ",
  "kNakRohini": "ಸೃಜನಶೀಲ, ಇಂದ್ರಿಯ, ಪೋಷಣೆ, ಕಾಂತೀಯ",
  "kNakMrigashira": "ಹುಡುಕುವ, ಕುತೂಹಲಕಾರಿ, ಸೌಮ್ಯ",
  "kNakArdra": "ಬಿರುಗಾಳಿ, ಪರಿವರ್ತಕ, ಒತ್ತಡದಲ್ಲಿ ಅದ್ಭುತ",
  "kNakPunarvasu": "ನವೀಕರಿಸುವುದು, ಉದಾರ, ಸುರಕ್ಷತೆಗೆ ಮರಳುವುದು",
  "kNakPushya": "ಪೋಷಣೆ ನೀಡುವ, ಕರ್ತವ್ಯನಿಷ್ಠ, ಆಳವಾಗಿ ಬೆಂಬಲಿಸುವ",
  "kNakAshlesha": "ಗ್ರಹಿಸುವ, ಕಾರ್ಯತಂತ್ರದ, ಸಂಮೋಹನ",
  "kNakMagha": "ರಾಜಮನೆತನದ, ಸಂಪ್ರದಾಯಬದ್ಧ, ಪೂರ್ವಜ",
  "kNakPurvaPhalguni": "ತಮಾಷೆಯ, ಪ್ರಣಯಭರಿತ, ಮೌಲ್ಯಯುತ ವಿರಾಮ",
  "kNakUttaraPhalguni": "ವಿಶ್ವಾಸಾರ್ಹ, ಒಪ್ಪಂದದ, ಸಹಾಯಕ",
  "kNakHasta": "ಕೈಗಳಲ್ಲಿ ನೈಪುಣ್ಯ, ಚತುರ, ಗುಣಪಡಿಸುವ",
  "kNakChitra": "ಕಲಾತ್ಮಕ, ಆಕರ್ಷಕ, ಸುಂದರವಾದ ವಸ್ತುಗಳನ್ನು ನಿರ್ಮಿಸುತ್ತದೆ",
  "kNakSwati": "ಸ್ವತಂತ್ರ, ಹೊಂದಿಕೊಳ್ಳುವ, ಸ್ವಾತಂತ್ರ್ಯ ಪ್ರಿಯ",
  "kNakVishakha": "ಗುರಿ-ಚಾಲಿತ, ದೃಢನಿಶ್ಚಯ, ದ್ವಂದ್ವ ಸ್ವಭಾವದ",
  "kNakAnuradha": "ಶ್ರದ್ಧೆಯುಳ್ಳ, ಸ್ನೇಹಪರ, ವಿದೇಶದಲ್ಲಿ ಅಭಿವೃದ್ಧಿ ಹೊಂದುತ್ತಾನೆ",
  "kNakJyeshtha": "ಹಿರಿಯ, ಜವಾಬ್ದಾರಿಯುತ, ಹೊರೆಗಳನ್ನು ಹೊತ್ತವನು",
  "kNakMula": "ಬೇರು ಹುಡುಕುವ, ಮೂಲಭೂತ, ಮೂಲಕ್ಕೆ ಹೋಗುತ್ತದೆ",
  "kNakPurvaAshadha": "ಅಜೇಯ ಚೈತನ್ಯ, ಮನವೊಲಿಸುವ",
  "kNakUttaraAshadha": "ತತ್ವಬದ್ಧ, ಶಾಶ್ವತ, ನಂತರದ ಯಶಸ್ಸು",
  "kNakShravana": "ಆಲಿಸುವುದು, ಕಲಿಯುವುದು, ಜನರನ್ನು ಸಂಪರ್ಕಿಸುವುದು",
  "kNakDhanishta": "ಲಯಬದ್ಧ, ಶ್ರೀಮಂತ, ಸಂಗೀತಮಯ, ಹೊಂದಿಕೊಳ್ಳುವ",
  "kNakShatabhisha": "ಖಾಸಗಿ, ಗುಣಪಡಿಸುವಿಕೆ, ವ್ಯವಸ್ಥೆ-ಮನಸ್ಸಿನ",
  "kNakPurvaBhadrapada": "ಆದರ್ಶವಾದಿ, ತೀವ್ರ, ಪರಿವರ್ತಕ",
  "kNakUttaraBhadrapada": "ಆಳವಾದ, ಶಾಂತ, ಬುದ್ಧಿವಂತ ಸಲಹೆ",
  "kNakRevati": "ದಯಾಳು, ಪ್ರಯಾಣಿಕರನ್ನು ರಕ್ಷಿಸುವ, ಕಲ್ಪನಾಶೀಲ",
  "kSadeSatiRising": "ಉದಯ ಹಂತ — ಶನಿಯು ನಿಮ್ಮ ಚಂದ್ರನಿಂದ 12 ನೇ ರಾಶಿಯಲ್ಲಿದ್ದಾನೆ. ಅಂತ್ಯಗಳು, ಆಯಾಸ ಮತ್ತು ಕೆಲಸಗಳು ಮುಗಿಯುತ್ತಿವೆ ಎಂಬ ಭಾವನೆ. ಇನ್ನು ಮುಂದೆ ಕೆಲಸ ಮಾಡದಿರುವುದನ್ನು ತೆರವುಗೊಳಿಸಲು ಪ್ರಾರಂಭಿಸಿ.",
  "kSadeSatiPeak": "ಗರಿಷ್ಠ ಹಂತ — ಶನಿಯು ನಿಮ್ಮ ಚಂದ್ರ ರಾಶಿಯ ಮೇಲೆ ನಿಂತಿದ್ದಾನೆ. ಅತ್ಯಂತ ಭಾರವಾದ ಹಂತ: ಜವಾಬ್ದಾರಿ, ಒತ್ತಡ ಮತ್ತು ನಿಧಾನಗತಿಯ ಪ್ರಗತಿ. ದಿನಚರಿಗಳನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳಿ, ನಿಮ್ಮ ಆರೋಗ್ಯವನ್ನು ರಕ್ಷಿಸಿ.",
  "kSadeSatiSetting": "ಸೆಟ್ಟಿಂಗ್ ಹಂತ — ಶನಿಯು ನಿಮ್ಮ ಚಂದ್ರನಿಂದ ಎರಡನೇ ರಾಶಿಯಲ್ಲಿದ್ದಾನೆ. ತೂಕ ಹೆಚ್ಚಾಗುತ್ತದೆ. ಹಣ ಮತ್ತು ಕುಟುಂಬ ಸ್ಥಿರಗೊಳ್ಳುತ್ತದೆ; ಕಳೆದ ವರ್ಷಗಳ ಪಾಠಗಳು ಫಲ ನೀಡಲು ಪ್ರಾರಂಭಿಸುತ್ತವೆ.",
  "kSadeSatiGeneric": "ಶನಿಯು ನಿಮ್ಮ ಚಂದ್ರನ ಸುತ್ತ ರಾಶಿಗಳಲ್ಲಿ ಸಾಗುತ್ತಿದೆ.",
  "kPlanetInSignHouse": "{sign} ಯಲ್ಲಿರುವ ನಿಮ್ಮ {planet} ವು ನಿಮ್ಮನ್ನು {signTrait} ಮಾಡುತ್ತದೆ. {house} ಮನೆಯಲ್ಲಿ ಅದು {houseTheme} ಅನ್ನು ಮುಟ್ಟುತ್ತದೆ.",
