  "doshaMangalName": "ಮಂಗಲ್ ದೋಷ",
  "doshaMangalMeaning": "ಸೂಕ್ಷ್ಮ ಮನೆಯಲ್ಲಿ ಮಂಗಳ - ಸಾಂಪ್ರದಾಯಿಕವಾಗಿ ಮದುವೆಗೆ ಮೊದಲು ತೂಕ ಇಡಲಾಗುತ್ತದೆ. ಇಬ್ಬರೂ ಪಾಲುದಾರರು ಮಂಗಳ ಗ್ರಹದ ಮೇಲೆ ಪ್ರಭಾವ ಬೀರಿದಾಗ ಅಥವಾ ಗುರು ಗ್ರಹದ ಪ್ರಭಾವದಡಿಯಲ್ಲಿದ್ದಾಗ ಹೆಚ್ಚಾಗಿ ಸಮತೋಲನದಲ್ಲಿರುತ್ತಾರೆ.",
  "doshaKaalSarpaName": "ಕಾಲ ಸರ್ಪ ದೋಷ",
  "doshaKaalSarpaMeaning": "ರಾಹು ಮತ್ತು ಕೇತುವಿನ ನಡುವೆ ನಡೆಯುವ ಇಡೀ ನಕ್ಷೆ - ಸ್ಪಷ್ಟ ನಿರ್ದೇಶನ ದೊರೆಯುವವರೆಗೆ ಜೀವನವು ಸೀಮಿತವಾಗಿರುತ್ತದೆ, ನಂತರ ಗಮನವು ತೀವ್ರವಾಗುತ್ತದೆ.",
  "doshaPitraName": "ಪಿತ್ರ ದೋಷ",
  "doshaPitraMeaning": "ಸೂರ್ಯ ಮತ್ತು 9 ನೇ ಮನೆಯು ಪೂರ್ವಜರ ಕರ್ಮದ ನೆರಳನ್ನು ಹೊಂದಿರುತ್ತದೆ - ಇದನ್ನು ಹೆಚ್ಚಾಗಿ ತಂದೆಯ ಹೆಸರಿನಲ್ಲಿ ಶ್ರದ್ಧೆ ಮತ್ತು ದಾನದಿಂದ ಸಂಬೋಧಿಸಲಾಗುತ್ತದೆ.",
  "doshaGandmoolName": "ಗಂಡಮೂಲ ದೋಸೆ",
  "doshaGandmoolMeaning": "ಚಂದ್ರನು ಜಂಕ್ಷನ್ ನಕ್ಷತ್ರದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುತ್ತಾನೆ. 27 ನೇ ದಿನದಂದು ಶಾಂತಿ ಪೂಜೆ ಮಾಡುವುದು ಸಾಂಪ್ರದಾಯಿಕ ಪ್ರತಿಕ್ರಿಯೆಯಾಗಿದೆ.",
  "doshaGrahanName": "ಗ್ರಹಣ ದೋಷ",
  "doshaGrahanMeaning": "ಒಂದು ಜ್ಯೋತಿಷಿ (ಸೂರ್ಯ ಅಥವಾ ಚಂದ್ರ) ಒಂದು ನೋಡ್‌ನೊಂದಿಗೆ ಕುಳಿತುಕೊಳ್ಳುತ್ತಾನೆ, ಆದ್ದರಿಂದ ಆ ಗ್ರಹದ ಮಹತ್ವಗಳು ಅದರ ಮೇಲೆ ಕೆಲಸ ಮಾಡುವವರೆಗೆ ಮಂದವಾಗಿರುತ್ತವೆ.",
  "doshaShrapitName": "ಶ್ರಪಿತ್ ದೋಷ",
  "doshaShrapitMeaning": "ರಾಹು ಜೊತೆ ಶನಿ - ಆರಂಭದಲ್ಲಿ ವಿಳಂಬ ಮತ್ತು ಗೊಂದಲ; ಸ್ಥಿರ, ತಾಳ್ಮೆಯ ಪ್ರಯತ್ನವೇ ದಾರಿ.",
  "doshaGuruChandalName": "ಗುರು ಚಂದಲ್ ದೋಷ",
  "doshaGuruChandalMeaning": "ನೋಡ್ ಹೊಂದಿರುವ ಗುರು - ಅಸಾಂಪ್ರದಾಯಿಕ ವಿಚಾರಗಳೊಂದಿಗೆ ಬೆರೆತ ಬುದ್ಧಿವಂತಿಕೆ; ನಿಮ್ಮ ಶಿಕ್ಷಕರು ಮತ್ತು ನಂಬಿಕೆಗಳನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಆರಿಸಿ.",
  "doshaAngarakName": "ಅಂಗಾರಕ ದೋಸೆ",
  "doshaAngarakMeaning": "ನೋಡ್ ಹೊಂದಿರುವ ಮಂಗಳ - ಹಠಾತ್ ಪ್ರವೃತ್ತಿಯ ಆವೇಶ; ಕೋಪ, ಅಪಘಾತಗಳು ಮತ್ತು ಆಸ್ತಿ ವಿವಾದಗಳಿಗೆ ಎಚ್ಚರಿಕೆಯ ಅಗತ್ಯವಿದೆ.",
  "doshaKemadrumaName": "ಕೇಮದ್ರುಮ ದೋಷ",
  "doshaKemadrumaMeaning": "ಚಂದ್ರನು ತನ್ನ ಸುತ್ತಲೂ ಯಾವುದೇ ಆಧಾರವಿಲ್ಲದೆ ಏಕಾಂಗಿಯಾಗಿ ನಿಲ್ಲುತ್ತಾನೆ - ಒಂದು ಕೇಂದ್ರವು ಆಕ್ರಮಿಸಿಕೊಂಡಾಗ ಅಥವಾ ಚಂದ್ರನು ಬಲವಾಗಿದ್ದಾಗ ಅದು ಸಡಿಲಗೊಳ್ಳುತ್ತದೆ.",
