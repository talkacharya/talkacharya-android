<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or device-transfer app data. flutter_secure_storage's
     keys are bound to this device's Keystore, so a restored copy can't be decrypted
     and would crash/log the user out on the new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
